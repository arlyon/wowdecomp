+  HRESULT STDMETHODCALLTYPE D3D9CpuIdentity::GetAdapterIdentity(
+          UINT ordinal, D3D9CpuAdapterIdentity1* identity) {
+    if (!identity || identity->size != sizeof(*identity) || identity->version != 1)
+      return D3DERR_INVALIDCALL;
+    auto* adapter = m_interface->GetAdapter(ordinal);
+    if (!adapter)
+      return D3DERR_INVALIDCALL;
+    auto physical = adapter->GetDXVKAdapter();
+    VkPhysicalDeviceIDProperties id = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES };
+    VkPhysicalDeviceDriverProperties driver = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES };
+    VkPhysicalDeviceProperties2 props = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2 };
+    props.pNext = &id;
+    id.pNext = &driver;
+    // DXVK v3.1.1 requires Vulkan 1.3, including driver and ID properties.
+    physical->vki()->vkGetPhysicalDeviceProperties2(physical->handle(), &props);
+    D3D9CpuAdapterIdentity1 result = { };
+    result.size = sizeof(result);
+    result.version = 1;
+    std::memcpy(result.deviceUUID, id.deviceUUID, sizeof(result.deviceUUID));
+    std::memcpy(result.driverUUID, id.driverUUID, sizeof(result.driverUUID));
+    result.driverId = uint32_t(driver.driverID);
+    result.vendorId = props.properties.vendorID;
+    result.deviceId = props.properties.deviceID;
+    std::memcpy(result.name, props.properties.deviceName, sizeof(result.name));
+    result.name[sizeof(result.name) - 1] = 0;
+    *identity = result;
+    return D3D_OK;
+  }
