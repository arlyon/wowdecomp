# A passing negative case must differ from a successful positive control only by
# removing one declared-mode handler. Do not accept arbitrary tool/include errors.
foreach (required COMPILER ROOT SOURCE OUTPUT)
    if (NOT DEFINED ${required})
        message(FATAL_ERROR "Missing shadow contract check parameter: ${required}")
    endif ()
endforeach ()
file(MAKE_DIRECTORY "${OUTPUT}")
foreach (mode positive coverage participation)
    set(defines)
    if (mode STREQUAL "coverage")
        set(defines -DTEST_UNHANDLED_COVERAGE=1)
        set(expected NewCoverage)
    elseif (mode STREQUAL "participation")
        set(defines -DTEST_UNHANDLED_PARTICIPATION=1)
        set(expected NewParticipation)
    endif ()
    execute_process(COMMAND "${COMPILER}" -std=c++17 -fsyntax-only "-I${ROOT}" ${defines} "${SOURCE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    file(WRITE "${OUTPUT}/${mode}.log" "${output}${errors}")
    if (mode STREQUAL "positive")
        if (NOT result EQUAL 0)
            message(FATAL_ERROR "Shadow contract positive control failed; see ${OUTPUT}/positive.log")
        endif ()
    elseif (result EQUAL 0 OR NOT "${errors}" MATCHES "${expected}")
        message(FATAL_ERROR "Missing ${mode} handler was not specifically rejected; see ${OUTPUT}/${mode}.log")
    endif ()
endforeach ()
message(STATUS "Closed coverage/participation: positive control succeeds; both missing-handler compilations reject the new declared type")
