# Target identity, not host identity. Keep pointer width separate from instruction set.
set(WOWDECOMP_OS "${CMAKE_SYSTEM_NAME}")
set(WOWDECOMP_POSIX OFF)
if (WOWDECOMP_OS STREQUAL "Linux" OR WOWDECOMP_OS STREQUAL "Darwin")
    set(WOWDECOMP_POSIX ON)
elseif (NOT WOWDECOMP_OS STREQUAL "Windows")
    message(FATAL_ERROR "Unsupported target OS: ${WOWDECOMP_OS}")
endif ()

set(_wow_processor "${CMAKE_SYSTEM_PROCESSOR}")
if (APPLE AND CMAKE_OSX_ARCHITECTURES)
    list(LENGTH CMAKE_OSX_ARCHITECTURES _wow_arch_count)
    if (NOT _wow_arch_count EQUAL 1)
        message(FATAL_ERROR "Build one macOS architecture at a time; universal builds are not supported yet.")
    endif ()
    set(_wow_processor "${CMAKE_OSX_ARCHITECTURES}")
elseif (CMAKE_GENERATOR_PLATFORM)
    set(_wow_processor "${CMAKE_GENERATOR_PLATFORM}")
elseif (CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
    set(_wow_processor "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
endif ()
string(TOLOWER "${_wow_processor}" _wow_processor)
if (_wow_processor MATCHES "^(amd64|x86_64|x64|i[3-6]86|x86|win32)$")
    if (CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(WOWDECOMP_CPU x86_64)
    else ()
        set(WOWDECOMP_CPU x86)
    endif ()
elseif (_wow_processor MATCHES "^(aarch64|arm64)$")
    set(WOWDECOMP_CPU arm64)
else ()
    message(FATAL_ERROR "Unsupported target CPU: ${_wow_processor}")
endif ()

set(WOWDECOMP_ARCH_32 OFF)
set(WOWDECOMP_ARCH_64 OFF)
if (CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(WOWDECOMP_POINTER_BITS 64)
    set(WOWDECOMP_ARCH_64 ON)
elseif (CMAKE_SIZEOF_VOID_P EQUAL 4 AND WOWDECOMP_CPU STREQUAL "x86")
    set(WOWDECOMP_POINTER_BITS 32)
    set(WOWDECOMP_ARCH_32 ON)
else ()
    message(FATAL_ERROR "Unsupported pointer width for ${WOWDECOMP_CPU}: ${CMAKE_SIZEOF_VOID_P}")
endif ()
set(WOWDECOMP_COMPILER "${CMAKE_CXX_COMPILER_ID}")
message(STATUS "WoW target: ${WOWDECOMP_OS}/${WOWDECOMP_CPU}, ${WOWDECOMP_POINTER_BITS}-bit, ${WOWDECOMP_COMPILER}")

# Filter overlays without treating pointer width as an OS or instruction set.
# Windows retains both legacy Win32/Win64 directories: their layout guards select
# the original implementations. POSIX/SDL overlays belong to the native ports.
function(wowdecomp_filter_platform_sources output)
    set(sources ${ARGN})
    if (WOWDECOMP_OS STREQUAL "Windows")
        list(FILTER sources EXCLUDE REGEX "/(Linux|Darwin|Posix|SDL)/")
    else ()
        list(FILTER sources EXCLUDE REGEX "/(Win32|Win64)/")
        if (WOWDECOMP_OS STREQUAL "Linux")
            list(FILTER sources EXCLUDE REGEX "/Darwin/")
        else ()
            list(FILTER sources EXCLUDE REGEX "/Linux/")
        endif ()
        if (WOWDECOMP_CPU STREQUAL "arm64")
            list(FILTER sources EXCLUDE REGEX "/Arch/X86/")
        else ()
            list(FILTER sources EXCLUDE REGEX "/Arch/ARM64/")
        endif ()
    endif ()
    set(${output} ${sources} PARENT_SCOPE)
endfunction()

# Call once per project after project(). Legacy ARCH macros describe layout only.
macro(wowdecomp_configure_platform)
    add_compile_definitions(WOWDECOMP_ARCH_${WOWDECOMP_POINTER_BITS}=1)
    if (WIN32 AND WOWDECOMP_ARCH_32)
        add_compile_definitions(_USE_32BIT_TIME_T)
        if (MSVC)
            add_compile_options(/arch:IA32 /fp:fast)
        endif ()
    endif ()
endmacro()
