set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_SIZEOF_VOID_P 8)
set(CMAKE_CXX_COMPILER_ID GNU)
set(expected_cpu x86_64)
set(expected_bits 64)
if (CASE MATCHES "^windows-")
    set(CMAKE_SYSTEM_NAME Windows)
    # A 64-bit host can target Win32; do not use host CPU to infer ABI width.
    set(CMAKE_SYSTEM_PROCESSOR AMD64)
    set(CMAKE_CXX_COMPILER_ID MSVC)
    if (CASE STREQUAL "windows-x86")
        set(CMAKE_GENERATOR_PLATFORM Win32)
        set(CMAKE_SIZEOF_VOID_P 4)
        set(expected_cpu x86)
        set(expected_bits 32)
    elseif (CASE STREQUAL "windows-arm64")
        set(CMAKE_GENERATOR_PLATFORM ARM64)
        set(expected_cpu arm64)
    else ()
        set(CMAKE_GENERATOR_PLATFORM x64)
    endif ()
elseif (CASE MATCHES "^macos-")
    set(CMAKE_SYSTEM_NAME Darwin)
    set(APPLE TRUE)
    set(CMAKE_CXX_COMPILER_ID AppleClang)
    # Explicit cross target takes precedence over the build machine's CPU.
    if (CASE STREQUAL "macos-arm64")
        set(CMAKE_OSX_ARCHITECTURES arm64)
        set(expected_cpu arm64)
    else ()
        set(CMAKE_SYSTEM_PROCESSOR arm64)
        set(CMAKE_OSX_ARCHITECTURES x86_64)
    endif ()
elseif (CASE STREQUAL "linux-arm64")
    set(CMAKE_SYSTEM_PROCESSOR aarch64)
    set(expected_cpu arm64)
elseif (CASE STREQUAL "unknown-os")
    set(CMAKE_SYSTEM_NAME FreeBSD)
elseif (CASE STREQUAL "unknown-cpu")
    set(CMAKE_SYSTEM_PROCESSOR mystery)
elseif (CASE STREQUAL "bad-width")
    set(CMAKE_SYSTEM_PROCESSOR aarch64)
    set(CMAKE_SIZEOF_VOID_P 4)
elseif (CASE STREQUAL "universal")
    set(CMAKE_SYSTEM_NAME Darwin)
    set(APPLE TRUE)
    set(CMAKE_OSX_ARCHITECTURES "arm64;x86_64")
endif ()
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/WowPlatform.cmake")
if (NOT WOWDECOMP_CPU STREQUAL expected_cpu OR NOT WOWDECOMP_POINTER_BITS EQUAL expected_bits)
    message(FATAL_ERROR "Wrong target: ${WOWDECOMP_CPU}/${WOWDECOMP_POINTER_BITS}, expected ${expected_cpu}/${expected_bits}")
endif ()
if (CMAKE_SYSTEM_NAME STREQUAL "Windows")
    if (WOWDECOMP_POSIX)
        message(FATAL_ERROR "Windows must not select POSIX sources")
    endif ()
elseif (NOT WOWDECOMP_POSIX)
    message(FATAL_ERROR "Linux/macOS must select POSIX sources")
endif ()

set(fixture /module/Common.cpp /module/Win32/Impl.cpp /module/Win64/Impl.cpp
    /module/Linux/Impl.cpp /module/Darwin/Impl.cpp /module/Posix/Impl.cpp
    /module/SDL/Impl.cpp /module/Native/Impl.cpp /module/Posix/Arch/X86/Impl.cpp /module/Posix/Arch/ARM64/Impl.cpp)
wowdecomp_filter_platform_sources(selected ${fixture})
if (WOWDECOMP_OS STREQUAL "Windows")
    set(expected /module/Common.cpp /module/Win32/Impl.cpp /module/Win64/Impl.cpp)
else ()
    set(expected /module/Common.cpp /module/${WOWDECOMP_OS}/Impl.cpp /module/Posix/Impl.cpp /module/SDL/Impl.cpp /module/Native/Impl.cpp)
    if (WOWDECOMP_CPU STREQUAL "arm64")
        list(APPEND expected /module/Posix/Arch/ARM64/Impl.cpp)
    else ()
        list(APPEND expected /module/Posix/Arch/X86/Impl.cpp)
    endif ()
endif ()
if (NOT selected STREQUAL expected)
    message(FATAL_ERROR "Wrong source overlays: ${selected}; expected ${expected}")
endif ()
